{
  "permissions": {
    "allow": [
      "Bash(curl -s https://api.github.com/repos/antonlabukhin-hue/kart-racer/*)",
      "Bash(curl -s \"https://api.github.com/repos/antonlabukhin-hue/kart-racer/*)",
      "Bash(npx vitest run)",
      "Bash(npx vitest related:*)",
      "Bash(npm run test:unit)",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__read_page",
      "mcp__terminal__read_terminal",
      "mcp__ccd_session__read_widget_context",
      "mcp__context7"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.mjs\"", "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/main-lines.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/related-tests.mjs\"", "timeout": 120 }
        ]
      }
    ]
  }
}
